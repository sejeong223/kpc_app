# App
NODE_ENV=development
APP_ENV=local
NEXT_PUBLIC_APP_NAME=KPC App
NEXT_PUBLIC_APP_DESCRIPTION=사내 업무 애플리케이션

# Auth feature flags
AUTH_ENABLED=false
EMBEDDED_MODE=false
AUTH_CACHE_NAMESPACE=kpc_app

# NextAuth and Microsoft Entra ID
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
MSAL_TENANT_ID=
MSAL_CLIENT_ID=

# Set exactly one credential when AUTH_ENABLED=true.
MSAL_CLIENT_SECRET=
MSAL_CERT_PFX=
MSAL_CERT_PASSWORD=

# Redis
# Required when authentication is enabled in production.
REDIS_URL=
REDIS_CLUSTER_MODE=false

# Embedded CSP
# Comma-separated https://host or https://*.host sources.
IFRAME_ALLOWED_DOMAINS=

# Azure data services
# Use managed identity in Azure. Set false only for local key fallback.
AZURE_USE_MANAGED_IDENTITY=false
COSMOS_DB_ENDPOINT=
COSMOS_DB_NAME=
COSMOS_DB_KEY=
BLOB_ACCOUNT_NAME=
BLOB_ACCOUNT_KEY=
