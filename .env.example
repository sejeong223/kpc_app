# Application
NODE_ENV=development
APP_ENV=local
NEXT_PUBLIC_APP_NAME=KPC App
NEXT_PUBLIC_APP_DESCRIPTION=사내 업무 애플리케이션

# Authentication
AUTH_ENABLED=false
EMBEDDED_MODE=false
AUTH_CACHE_NAMESPACE=kpc_app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
MSAL_TENANT_ID=
MSAL_CLIENT_ID=

# Choose exactly one credential when AUTH_ENABLED=true.
MSAL_CLIENT_SECRET=
MSAL_CERT_PFX=
MSAL_CERT_PASSWORD=

# Cache
REDIS_URL=
REDIS_CLUSTER_MODE=false

# Azure data services
AZURE_USE_MANAGED_IDENTITY=false
COSMOS_DB_ENDPOINT=
COSMOS_DB_KEY=
COSMOS_DB_NAME=
BLOB_ACCOUNT_NAME=
BLOB_ACCOUNT_KEY=

# Comma-separated https://host or https://*.host sources.
IFRAME_ALLOWED_DOMAINS=
